// __assertion_handler — SaltyOS libc++ assertion handler
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//
// Normally generated by CMake from libcxx/include/__assertion_handler.in.
// SaltyOS uses the default LLVM implementation (verbose_abort).
// With _LIBCPP_HARDENING_MODE_NONE, this handler is never invoked.

#ifndef _LIBCPP___ASSERTION_HANDLER
#define _LIBCPP___ASSERTION_HANDLER

#include <__config>
#include <__verbose_abort>

#define _LIBCPP_ASSERTION_HANDLER(message) _LIBCPP_VERBOSE_ABORT("%s", message)

#endif // _LIBCPP___ASSERTION_HANDLER
